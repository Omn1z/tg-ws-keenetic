#!/bin/sh
# Entware service; one foreground process, RAM-backed startup/error log.
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
BIN=/opt/bin/tgwsproxy
CONFIG=/opt/etc/tgwsproxy/config.json
PIDFILE=/opt/var/run/tgwsproxy.pid
LOGFILE=/tmp/tgwsproxy.log
umask 077
running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    executable=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
    [ "$executable" = "$BIN" ] || [ "$executable" = "$BIN (deleted)" ]
}
start() {
    running && { echo "tgwsproxy running (PID $pid)"; return 0; }
    [ -x "$BIN" ] || { echo "Missing $BIN" >&2; return 1; }
    "$BIN" --config "$CONFIG" --check-config || return 1
    mkdir -p /opt/var/run
    rm -f "$PIDFILE"
    "$BIN" --config "$CONFIG" > "$LOGFILE" 2>&1 </dev/null &
    printf '%s\n' "$!" > "$PIDFILE"
    sleep 1
    running || { echo "Startup failed; see $LOGFILE" >&2; rm -f "$PIDFILE"; return 1; }
    echo "tgwsproxy started (PID $pid)"
}
stop() {
    if running; then
        kill -TERM "$pid" 2>/dev/null || return 1
        count=0
        while running && [ "$count" -lt 10 ]; do sleep 1; count=$((count + 1)); done
        if running; then kill -KILL "$pid" 2>/dev/null || return 1; fi
    fi
    rm -f "$PIDFILE"
}
case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status|check) if running; then echo "tgwsproxy running (PID $pid)"; else echo "tgwsproxy stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
