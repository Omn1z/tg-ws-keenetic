#!/bin/sh /etc/rc.common
# Native OpenWrt service, supervised by procd.
START=99
STOP=10
USE_PROCD=1
if [ -z "${SSL_CERT_FILE:-}" ] && [ -f /etc/ssl/certs/ca-certificates.crt ]; then
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
elif [ -z "${SSL_CERT_FILE:-}" ] && [ -f /opt/etc/ssl/certs/ca-certificates.crt ]; then
    export SSL_CERT_FILE=/opt/etc/ssl/certs/ca-certificates.crt
fi
if [ -z "${SSL_CERT_DIR:-}" ]; then
    if [ -d /etc/ssl/certs ]; then export SSL_CERT_DIR=/etc/ssl/certs
    elif [ -d /opt/etc/ssl/certs ]; then export SSL_CERT_DIR=/opt/etc/ssl/certs
    fi
fi
start_service() {
    /usr/bin/tgwsproxy --config /etc/tgwsproxy/config.json --check-config || return 1
    procd_open_instance
    procd_set_param command /usr/bin/tgwsproxy --config /etc/tgwsproxy/config.json
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/tgwsproxy/config.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 10
    procd_close_instance
}
reload_service() {
    stop
    start
}
